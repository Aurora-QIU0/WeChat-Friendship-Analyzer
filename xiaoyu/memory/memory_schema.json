{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xiaoyu memory envelope V1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "content",
          "source",
          "recorded_at",
          "updated_at",
          "time_precision",
          "confidence",
          "confirmed",
          "status",
          "revision",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "category": {
            "enum": [
              "personality",
              "user",
              "event",
              "relationship",
              "short_term"
            ]
          },
          "content": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "summary",
                  "tags"
                ],
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              }
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reference"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "user_request",
                  "user_confirmation",
                  "current_conversation",
                  "derived_candidate"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "time_precision": {
            "enum": [
              "day",
              "second"
            ]
          },
          "confidence": {
            "enum": [
              "explicit_statement",
              "observed",
              "uncertain"
            ]
          },
          "confirmed": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "active",
              "candidate",
              "deleted"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "active"
                },
                "category": {
                  "not": {
                    "const": "short_term"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "confirmed": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "short_term"
                },
                "status": {
                  "not": {
                    "const": "deleted"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "deleted"
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "content": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "properties": {
                    "kind": {
                      "const": "derived_candidate"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "enum": [
                    "candidate",
                    "deleted"
                  ]
                },
                "confirmed": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  }
}
