{
  "format": "xiaoyu-local-persona-manifest",
  "version": "1.1",
  "name": "小鱼",
  "english_name": "Xiaoyu",
  "locale": "zh-CN",
  "purpose": "人物资料索引；不是官方固件或云端可直接导入的配置格式",
  "prompts": {
    "file": "../character/system_prompt.md",
    "variants": [
      "完整版",
      "精简版",
      "语音短版"
    ],
    "recommended": "完整版"
  },
  "deployment": {
    "provider": "xiaozhi.me",
    "method": "用户手动复制一版提示词至角色介绍",
    "applied": false
  },
  "memory": {
    "backend_connected": false,
    "persistent_storage_deployed": false,
    "schema": "../memory/memory_schema.json",
    "private_initial_files": [],
    "rules": "../memory/memory_rules.md",
    "candidate_auto_promote": false,
    "templates": [
      "../memory/user_profile.example.json",
      "../memory/memory_seed.example.json"
    ]
  },
  "interaction": {
    "default_language": "普通话",
    "default_sentences": [
      1,
      3
    ],
    "technical_detail": "按问题和用户需要展开",
    "third_party_impersonation": false
  },
  "privacy": {
    "raw_chat_included": false,
    "binary_attachments_included": false,
    "private_memory_publication": false
  },
  "hardware_changes": false
}
